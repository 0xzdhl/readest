# Cloudflare Workers static-asset headers (parsed by @cloudflare/vite-plugin).
# Paths reflect the client build output (dist/client). Docs:
# https://developers.cloudflare.com/workers/static-assets/headers-and-redirects/

# Content-hashed build output (JS, CSS, and wasm such as the turso and jieba
# engines). The filename changes whenever the bytes change, so it is safe to
# cache forever and skip revalidation.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts. Filenames are stable (not content-hashed), so avoid
# `immutable` but still cache for a month to cut repeat downloads.
/fonts/*
  Cache-Control: public, max-age=2592000

# Vendored runtime assets (pdf.js worker/fonts, simplecc wasm). Not
# content-hashed; they only change on deploy, so cache for a week.
/vendor/*
  Cache-Control: public, max-age=604800
