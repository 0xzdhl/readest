# Copy this file to .env for local development.
# The web build, Drizzle Kit, Wrangler, and the Cloudflare Vite plugin all read .env.
# npm scripts set VITE_APP_PLATFORM for each target; do not set it here.

# ─── app assets ───────────────────────────────────────────────────────────
PDFJS_BUILD_PATH=../../packages/foliate-js/node_modules/pdfjs-dist/legacy/build
PDFJS_FONTS_PATH=../../packages/foliate-js/node_modules/pdfjs-dist
PDFJS_STYLE_PATH=../../packages/foliate-js/vendor/pdfjs

# ─── public client env ────────────────────────────────────────────────────
# Public-facing URLs and brand (required — no defaults; set per deployment)
VITE_API_BASE_URL=https://api.example.com
VITE_NODE_BASE_URL=https://node.example.com
VITE_WEBSITE_URL=https://www.example.com
VITE_DOWNLOAD_BASE_URL=https://download.example.com/releases
VITE_SUPPORT_EMAIL=support@example.com

VITE_BETTER_AUTH_URL=http://localhost:5173
VITE_STORAGE_FIXED_QUOTA=1073741824
VITE_TRANSLATION_FIXED_QUOTA=50000

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_DEFAULT_POSTHOG_URL_BASE64=PUT_YOUR_URL_HERE
VITE_DEFAULT_POSTHOG_KEY_BASE64=PUT_YOUR_KEY_HERE

VITE_STRIPE_PUBLISHABLE_KEY_DEV_BASE64=PUT_YOUR_KEY_HERE
VITE_STRIPE_PUBLISHABLE_KEY_BASE64=PUT_YOUR_KEY_HERE
VITE_USE_APPLE_SIGN_IN=false

# ─── database / auth ──────────────────────────────────────────────────────
# RUNTIME connection. MUST be the non-superuser `readest_app` role so Postgres
# row-level security (FORCE RLS, see migration 0004) actually enforces per-user
# scoping. A superuser/BYPASSRLS connection silently disables RLS, which lets
# cross-user data leak (the server's explicit eq(userId) predicates are the only
# remaining guard). The readest_app role is created by migration 0001.
#   Production (Supabase): create a dedicated non-superuser role (do NOT use the
#   `postgres` superuser or the `service_role`, both bypass RLS) and point this
#   at it. Privileged jobs opt into bypass explicitly via setRlsBypass().
DATABASE_URL=postgres://readest_app:readest_app@localhost:5432/postgres
# MIGRATION connection (drizzle-kit only). Migrations create roles, grant
# privileges and FORCE RLS, so they need a SUPERUSER. For local docker, use the
# postgres password from docker/.env. If unset, drizzle-kit falls back to
# DATABASE_URL.
DATABASE_MIGRATION_URL=postgres://postgres:readest-dev@localhost:5432/postgres

# Use `openssl rand -base64 32` to generate.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Registration toggle. Sign-up is enabled by default; set to 'true' to block
# all new-account creation (email/password, social, magic-link). Existing
# users can still sign in.
DISABLE_SIGNUP=false

# ─── email ────────────────────────────────────────────────────────────────
# Send routing (first match wins): Resend → Cloudflare Email Sending → SMTP.
RESEND_API_KEY=
SMTP_FROM_EMAIL=noreply@example.com
# Cloudflare Email Sending via REST API. Required on the Cloudflare Worker
# deployment — nodemailer SMTP cannot open raw TCP sockets in workerd, so the
# SMTP_* vars below only work on Node/Docker self-hosted builds (and local
# Mailpit). The token needs the "Email Sending: Edit" permission, and the
# SMTP_FROM_EMAIL domain must be onboarded to Cloudflare Email Sending.
# CLOUDFLARE_ACCOUNT_ID is shared with R2 object storage (see below).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH_USER=
SMTP_AUTH_TOKEN=

# ─── OAuth providers ──────────────────────────────────────────────────────
# Redirect URIs:
#   web:    ${BETTER_AUTH_URL}/api/auth/callback/<provider>
#   tauri:  http://localhost:<port>/  (port assigned at runtime)
#   mobile: readest://auth-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ─── AI / translation ─────────────────────────────────────────────────────
AI_GATEWAY_API_KEY=
AI_GATEWAY_EMBEDDING_MODEL=openai/text-embedding-3-small
DEEPL_PRO_API_KEYS=
DEEPL_FREE_API_KEYS=
DEEPL_PRO_API=https://api.deepl.com/v2/translate
DEEPL_FREE_API=https://api-free.deepl.com/v2/translate
DEEPL_X_FINGERPRINT=

# ─── object storage ───────────────────────────────────────────────────────
# OBJECT_STORAGE_TYPE chooses r2 or s3.
OBJECT_STORAGE_TYPE=s3
R2_TOKEN_VALUE=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# R2 endpoint host uses CLOUDFLARE_ACCOUNT_ID (set in the email section above).
R2_REGION=auto

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin-secret-password
S3_BUCKET_NAME=readest-files
S3_REGION=us-east-1

STORAGE_PUBLIC_BASE_URL=https://storage.example.com
TEMP_STORAGE_PUBLIC_BUCKET_NAME=

# ─── payments ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_DEV=
STRIPE_WEBHOOK_SECRET=

# ─── Tauri optional overrides ─────────────────────────────────────────────
TAURI_DEV_HOST=
VITE_DIST_CHANNEL=readest
VITE_DISABLE_UPDATER=false
VITE_PORTABLE_APP=false
