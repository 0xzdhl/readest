supportedArchitectures.os[]=current
supportedArchitectures.os[]=darwin
supportedArchitectures.os[]=linux
supportedArchitectures.os[]=win32
supportedArchitectures.cpu[]=current
supportedArchitectures.cpu[]=x64
supportedArchitectures.cpu[]=arm64
# Pin libc too, otherwise a lockfile regenerated on a non-glibc host (e.g. a
# maintainer on macOS) omits the linux glibc native bindings — notably
# @tursodatabase/database-linux-x64-gnu — and CI (ubuntu/glibc) then fails with
# "Cannot find native binding". Locking glibc + musl keeps them deterministic.
supportedArchitectures.libc[]=current
supportedArchitectures.libc[]=glibc
supportedArchitectures.libc[]=musl
